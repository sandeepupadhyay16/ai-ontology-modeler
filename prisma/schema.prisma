generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id                 String            @id @default(uuid())
  name               String            @unique
  description        String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  businessFunctionId String?
  ontologies         Ontology[]
  businessFunction   BusinessFunction? @relation(fields: [businessFunctionId], references: [id])
}

model Ontology {
  id                  String               @id @default(uuid())
  name                String
  namespaceUri        String               @unique
  layer               String               @default("PROJECT")
  version             String               @default("1.0.0")
  description         String?
  projectId           String?
  businessFunctionId  String?
  organizationId      String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  businessFunction    String?
  industry            String?
  objective           String?
  businessSolution    String?
  businessProcessName String?
  aiMissions          String[]             @default([])
  tags                String[]             @default([])
  businessProcessId   String?
  owlAxioms           Json?
  // Stage 5 module handling (idea.md's Layer 2/core vs Layer 3/extension split —
  // see IMPLEMENTATION_PLAN.md "Cross-cutting: Extension & module handling").
  // "core" | "extension:<domainProfileKey>". extendsOntologyId is only set on
  // extension rows and points at the core Ontology they owl:import; core rows
  // never point at an extension (the enforced one-way dependency).
  moduleScope         String               @default("core")
  extendsOntologyId   String?
  extendsOntology     Ontology?            @relation("OntologyExtends", fields: [extendsOntologyId], references: [id], onDelete: SetNull)
  extendedBy          Ontology[]           @relation("OntologyExtends")
  causalCycles        CausalCycle[]
  competencyQuestions CompetencyQuestion[]
  concepts            Concept[]
  constraints         Constraint[]
  contextPacks        ContextPack[]
  driverTrees         DriverTree[]
  businessProcess     BusinessProcess?     @relation(fields: [businessProcessId], references: [id])
  project             Project?             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  businessFunctionRel BusinessFunction?    @relation("FunctionOntologies", fields: [businessFunctionId], references: [id], onDelete: Cascade)
  organization        Organization?        @relation("OrgOntologies", fields: [organizationId], references: [id], onDelete: Cascade)
  perspectives        Perspective[]
  relationships       Relationship[]
  rules               Rule[]
  modelingSessions    ModelingSession[]
  ontologyVersions    OntologyVersion[]
}

model Concept {
  id                  String             @id @default(uuid())
  uri                 String?
  label               String
  description         String? // Stage 5: populated at promotion from the candidate's payload description; enables label+type+description dedup embedding
  conceptType         String             @default("Entity")
  typeFields          Json?
  parentConceptId     String?
  ontologyId          String
  createdAt           DateTime           @default(now())
  attributes          Attribute[]
  ontology            Ontology           @relation(fields: [ontologyId], references: [id], onDelete: Cascade)
  parentConcept       Concept?           @relation("ConceptHierarchy", fields: [parentConceptId], references: [id], onDelete: SetNull)
  subConcepts         Concept[]          @relation("ConceptHierarchy")
  mappings            DataMapping[]
  personaPerspectives Perspective[]      @relation("PersonaPerspective")
  sourceRel           Relationship[]     @relation("SourceConcept")
  targetRel           Relationship[]     @relation("TargetConcept")
  perspectives        Perspective[]      @relation("PerspectiveConcepts")
  dupCandidates       CandidateConcept[] @relation("CandidateDupTarget")
  mergeCandidates     CandidateConcept[] @relation("CandidateMergeTarget")
  parentOverrideFor   CandidateConcept[] @relation("CandidateParentOverride")
  promotedFrom        CandidateConcept[] @relation("CandidatePromotedConcept")
  glossaryDrafts      GlossaryDraft[]
  embedding           Float[]            @default([]) // Stage 4: dup/conflict detection vector
  embeddingModel      String? // pinned model id the vector was generated with — see src/lib/embeddings.ts
  embeddingDim        Int? // dims of `embedding` — must match embeddingModel's pinned output dim to be comparable
}

model Attribute {
  id          String  @id @default(uuid())
  uri         String?
  name        String
  datatype    String  @default("string")
  description String?
  required    Boolean @default(false)
  conceptId   String
  concept     Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  // Stage 6 traceability: which ChangeSet's promotion created this row — set by
  // src/lib/promotion.ts on BOTH the brand-new-concept path and the merge-additive-attribute
  // path. Needed because Attribute has no createdAt to approximate "added by changeset X" from,
  // and a merge's new attributes land on an EXISTING Concept (whose own promotedConceptId
  // traceability only identifies newly-created concepts, not attributes added onto one that
  // already existed) — src/lib/ttlDiff.ts reads this to know exactly which properties are new.
  addedInChangeSetId String?
  addedInChangeSet   ChangeSet? @relation(fields: [addedInChangeSetId], references: [id], onDelete: SetNull)
  ruleDrafts         RuleDraft[]
}

model Relationship {
  id             String             @id @default(uuid())
  uri            String?
  name           String
  description    String?
  cardinality    String             @default("one-to-many")
  propertyType   String             @default("ObjectProperty")
  sourceId       String
  targetId       String
  ontologyId     String
  ontology       Ontology           @relation(fields: [ontologyId], references: [id], onDelete: Cascade)
  source         Concept            @relation("SourceConcept", fields: [sourceId], references: [id], onDelete: Cascade)
  target         Concept            @relation("TargetConcept", fields: [targetId], references: [id], onDelete: Cascade)
  glossaryDrafts GlossaryDraft[]
  promotedFrom   CandidateConcept[] @relation("CandidatePromotedRelationship")
  ruleDrafts     RuleDraft[]
}

model Constraint {
  id          String   @id @default(uuid())
  name        String
  kind        String
  params      Json?
  shaclShape  Json?
  description String?
  ontologyId  String
  ontology    Ontology @relation(fields: [ontologyId], references: [id], onDelete: Cascade)
}

model Rule {
  id          String   @id @default(uuid())
  name        String
  kind        String
  antecedent  Json?
  consequent  Json?
  description String?
  ontologyId  String
  ontology    Ontology @relation(fields: [ontologyId], references: [id], onDelete: Cascade)
}

model CompetencyQuestion {
  id          String   @id @default(uuid())
  question    String
  status      String   @default("Draft")
  remediation String?
  ontologyId  String
  ontology    Ontology @relation(fields: [ontologyId], references: [id], onDelete: Cascade)
}

model DriverTree {
  id         String       @id @default(uuid())
  name       String
  ontologyId String
  edges      DriverEdge[]
  ontology   Ontology     @relation(fields: [ontologyId], references: [id], onDelete: Cascade)
}

model DriverEdge {
  id       String        @id @default(uuid())
  name     String
  sourceId String
  targetId String
  treeId   String
  polarity String        @default("+")
  weight   Float         @default(1.0)
  tree     DriverTree    @relation(fields: [treeId], references: [id], onDelete: Cascade)
  cycles   CausalCycle[] @relation("CycleEdges")
}

model PromptTemplate {
  id               String   @id @default(uuid())
  industry         String
  domain           String
  businessFunction String
  objective        String
  description      String?
  causalCycles     Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([industry, domain, businessFunction])
}

model Perspective {
  id          String    @id @default(uuid())
  name        String
  description String?
  personaId   String?
  ontologyId  String
  createdAt   DateTime  @default(now())
  ontology    Ontology  @relation(fields: [ontologyId], references: [id], onDelete: Cascade)
  persona     Concept?  @relation("PersonaPerspective", fields: [personaId], references: [id], onDelete: Cascade)
  concepts    Concept[] @relation("PerspectiveConcepts")
}

model CausalCycle {
  id          String       @id @default(uuid())
  name        String
  cycleType   String       @default("REINFORCING")
  description String?
  ontologyId  String
  createdAt   DateTime     @default(now())
  ontology    Ontology     @relation(fields: [ontologyId], references: [id], onDelete: Cascade)
  edges       DriverEdge[] @relation("CycleEdges")
}

model Organization {
  id                String             @id @default(uuid())
  name              String             @unique
  industry          String?
  description       String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  businessFunctions BusinessFunction[]
  ontologies        Ontology[]         @relation("OrgOntologies")
}

model BusinessFunction {
  id                String            @id @default(uuid())
  name              String
  category          String            @default("CORE")
  description       String?
  organizationId    String
  createdAt         DateTime          @default(now())
  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessProcesses BusinessProcess[]
  projects          Project[]
  ontologies        Ontology[]        @relation("FunctionOntologies")
}

model BusinessProcess {
  id                 String            @id @default(uuid())
  name               String
  description        String?
  parentId           String?
  businessFunctionId String
  createdAt          DateTime          @default(now())
  businessFunction   BusinessFunction  @relation(fields: [businessFunctionId], references: [id], onDelete: Cascade)
  parent             BusinessProcess?  @relation("ProcessHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children           BusinessProcess[] @relation("ProcessHierarchy")
  ontologies         Ontology[]
  solutions          SolutionLink[]
  systems            SystemLink[]
}

model BusinessSolution {
  id              String               @id @default(uuid())
  name            String
  description     String?
  status          String               @default("Active")
  businessOwnerId String?
  itOwnerId       String?
  createdAt       DateTime             @default(now())
  capabilities    BusinessCapability[]
  businessOwner   SolutionOwner?       @relation("BizOwner", fields: [businessOwnerId], references: [id])
  itOwner         SolutionOwner?       @relation("ITOwner", fields: [itOwnerId], references: [id])
  processLinks    SolutionLink[]
}

model BusinessCapability {
  id          String           @id @default(uuid())
  name        String
  description String?
  solutionId  String
  solution    BusinessSolution @relation(fields: [solutionId], references: [id], onDelete: Cascade)
}

model SolutionOwner {
  id                String             @id @default(uuid())
  name              String
  role              String
  team              String?
  email             String?
  bizOwnedSolutions BusinessSolution[] @relation("BizOwner")
  itOwnedSolutions  BusinessSolution[] @relation("ITOwner")
}

model SolutionLink {
  id         String           @id @default(uuid())
  processId  String
  solutionId String
  process    BusinessProcess  @relation(fields: [processId], references: [id], onDelete: Cascade)
  solution   BusinessSolution @relation(fields: [solutionId], references: [id], onDelete: Cascade)

  @@unique([processId, solutionId])
}

model System {
  id           String       @id @default(uuid())
  name         String       @unique
  systemType   String       @default("OPERATIONAL")
  vendor       String?
  description  String?
  createdAt    DateTime     @default(now())
  dataSources  DataSource[]
  processLinks SystemLink[]
}

model SystemLink {
  id        String          @id @default(uuid())
  processId String
  systemId  String
  role      String          @default("RUNS")
  process   BusinessProcess @relation(fields: [processId], references: [id], onDelete: Cascade)
  system    System          @relation(fields: [systemId], references: [id], onDelete: Cascade)

  @@unique([processId, systemId])
}

model DataSource {
  id            String        @id @default(uuid())
  name          String
  platform      String
  connectionRef String?
  systemId      String?
  createdAt     DateTime      @default(now())
  mappings      DataMapping[]
  system        System?       @relation(fields: [systemId], references: [id])
}

model DataMapping {
  id             String     @id @default(uuid())
  conceptId      String
  dataSourceId   String
  columnOrField  String?
  transformation String?
  confidence     Float      @default(1.0)
  status         String     @default("Proposed")
  concept        Concept    @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  dataSource     DataSource @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)

  @@unique([conceptId, dataSourceId])
}

model ContextPack {
  id          String   @id @default(uuid())
  name        String
  version     String   @default("0.1.0")
  ontologyId  String
  scope       Json
  contents    Json
  gapAnalysis Json?
  status      String   @default("Draft")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  ontology    Ontology @relation(fields: [ontologyId], references: [id], onDelete: Cascade)
}

model LlmConfiguration {
  id        String   @id @default(uuid())
  name      String
  provider  String
  apiKey    String?
  baseUrl   String?
  modelName String
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- Candidate staging + governance (conversational modeling assistant) ---
// idea.md "Data model" section. Status/decision fields below use plain String
// with a documented allowed set (matching this schema's existing convention,
// e.g. BusinessSolution.status, DataMapping.status) rather than Prisma enum.

model ModelingSession {
  id            String             @id @default(uuid())
  ontologyId    String
  domainProfile String?
  participant   String?
  status        String             @default("ACTIVE") // ACTIVE|COMPLETED
  startedAt     DateTime           @default(now())
  ontology      Ontology           @relation(fields: [ontologyId], references: [id], onDelete: Cascade)
  turns         ConversationTurn[]
  candidates    CandidateConcept[]
  changeSets    ChangeSet[]
}

model ConversationTurn {
  id             String             @id @default(uuid())
  sessionId      String
  ordinal        Int
  role           String // user|assistant
  content        String
  createdAt      DateTime           @default(now())
  session        ModelingSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  candidates     CandidateConcept[]
  glossaryDrafts GlossaryDraft[]
  ruleDrafts     RuleDraft[]

  @@unique([sessionId, ordinal])
}

model CandidateConcept {
  id                     String           @id @default(uuid())
  sessionId              String
  sourceTurnId           String
  label                  String
  candidateType          String // Entity|Relationship|Attribute|Event|...
  upperOntologyTag       String? // filled in Stage 3
  scope                  String           @default("core") // "core" | "extension:<domainProfileKey>" — set from the session's domain profile at extraction time (domain -> extension, no domain -> core); promotion to core is ontologist-gated at review
  dupStatus              String           @default("UNCHECKED") // UNCHECKED|UNIQUE|POSSIBLE_DUP|CONFLICT
  dupTargetConceptId     String?
  similarityScore        Float?
  decision               String           @default("PENDING") // PENDING|ACCEPTED|REJECTED|MERGED
  mergeTargetConceptId   String?
  parentConceptId        String? // ontologist override for promotion parenting; defaults to the Layer 1 tag-root when unset — see src/lib/promotion.ts
  payload                Json? // proposed attributes / relationships
  createdAt              DateTime         @default(now())
  // Stage 5 promotion traceability: which ChangeSet processed this candidate, and
  // what it became. promotedConceptId/promotedRelationshipId are set for both a
  // fresh ACCEPTED promotion and a MERGED redirect (mirrors mergeTargetConceptId
  // in the merge case) so "what did this candidate turn into" is a single lookup.
  changeSetId            String?
  promotedConceptId      String?
  promotedRelationshipId String?
  changeSet              ChangeSet?       @relation(fields: [changeSetId], references: [id], onDelete: SetNull)
  session                ModelingSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sourceTurn             ConversationTurn @relation(fields: [sourceTurnId], references: [id], onDelete: Cascade)
  dupTargetConcept       Concept?         @relation("CandidateDupTarget", fields: [dupTargetConceptId], references: [id], onDelete: SetNull)
  mergeTargetConcept     Concept?         @relation("CandidateMergeTarget", fields: [mergeTargetConceptId], references: [id], onDelete: SetNull)
  parentConceptOverride  Concept?         @relation("CandidateParentOverride", fields: [parentConceptId], references: [id], onDelete: SetNull)
  promotedConcept        Concept?         @relation("CandidatePromotedConcept", fields: [promotedConceptId], references: [id], onDelete: SetNull)
  promotedRelationship   Relationship?    @relation("CandidatePromotedRelationship", fields: [promotedRelationshipId], references: [id], onDelete: SetNull)
}

model ChangeSet {
  id              String             @id @default(uuid())
  sessionId       String
  status          String             @default("DRAFT") // DRAFT|APPROVED|VALIDATED|SIGNED_OFF|PUBLISHED
  ttlDiff         String? // Stage 6: concatenated multi-module Turtle patch (all touched modules, delimited by "### FILE:" headers) — see src/lib/ttlDiff.ts
  ttlFiles        Json? // Stage 6: the same patch broken out per module — { [ontologyId]: { moduleScope, namespaceUri, filename, ttl } } — "write extension concepts into the extension's TTL file (not core's)"
  diffSummary     String? // Stage 6: human-readable "what changed" text (idea.md §8), generated deterministically alongside ttlDiff/ttlFiles
  summary         String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  session         ModelingSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  glossaryDrafts  GlossaryDraft[]
  ruleDrafts      RuleDraft[]
  signoffs        Signoff[]
  ontologyVersion OntologyVersion?
  candidates      CandidateConcept[]
  attributesAdded Attribute[]
}

model GlossaryDraft {
  id                   String           @id @default(uuid())
  changeSetId          String
  linkedConceptId      String?
  linkedRelationshipId String?
  term                 String
  definition           String
  sourceTurnId         String
  confirmationStatus   String           @default("PENDING") // PENDING|CONFIRMED|REJECTED
  createdAt            DateTime         @default(now())
  changeSet            ChangeSet        @relation(fields: [changeSetId], references: [id], onDelete: Cascade)
  linkedConcept        Concept?         @relation(fields: [linkedConceptId], references: [id], onDelete: SetNull)
  linkedRelationship   Relationship?    @relation(fields: [linkedRelationshipId], references: [id], onDelete: SetNull)
  sourceTurn           ConversationTurn @relation(fields: [sourceTurnId], references: [id], onDelete: Cascade)
}

model RuleDraft {
  id                   String           @id @default(uuid())
  changeSetId          String
  // Dual real FKs (Stage 8, replacing the earlier polymorphic linkedPropertyId+Type): the
  // ontology property this rule reads from is either a datatype property (Attribute) or an
  // object property (Relationship). Real FKs give DB-enforced referential integrity, matching
  // GlossaryDraft's linkedConcept/linkedRelationship pattern. Exactly one is set.
  linkedAttributeId    String?
  linkedRelationshipId String?
  condition            Json
  derivedValue         Json
  // idea.md §6: when the user's statement is vague ("formulary tier determines access
  // priority") the elicitation asks for the explicit thresholds ("which tier levels map to
  // which priority?"). This holds that question; the ontologist answers by editing
  // condition/derivedValue before confirming. Null once the rule is fully specified.
  clarifyingQuestion   String?
  sourceTurnId         String
  confirmationStatus   String           @default("PENDING") // PENDING|CONFIRMED|REJECTED
  createdAt            DateTime         @default(now())
  changeSet            ChangeSet        @relation(fields: [changeSetId], references: [id], onDelete: Cascade)
  sourceTurn           ConversationTurn @relation(fields: [sourceTurnId], references: [id], onDelete: Cascade)
  linkedAttribute      Attribute?       @relation(fields: [linkedAttributeId], references: [id], onDelete: SetNull)
  linkedRelationship   Relationship?    @relation(fields: [linkedRelationshipId], references: [id], onDelete: SetNull)
}

model OntologyVersion {
  id           String    @id @default(uuid())
  ontologyId   String
  changeSetId  String    @unique
  gitCommitSha String? // filled in Stage 10
  changelog    String?
  createdAt    DateTime  @default(now())
  ontology     Ontology  @relation(fields: [ontologyId], references: [id], onDelete: Cascade)
  changeSet    ChangeSet @relation(fields: [changeSetId], references: [id], onDelete: Cascade)
}

model Signoff {
  id           String    @id @default(uuid())
  changeSetId  String
  approverRole String
  approver     String
  decision     String // APPROVED|REJECTED
  comments     String?
  decidedAt    DateTime?
  createdAt    DateTime  @default(now())
  changeSet    ChangeSet @relation(fields: [changeSetId], references: [id], onDelete: Cascade)
}
